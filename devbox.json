{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": ["nodejs@22"],
  "env": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "shell": {
    "init_hook": [
      "corepack enable --install-directory \"$DEVBOX_PROJECT_ROOT/.devbox/virtenv/nodejs/corepack-bin\""
    ],
    "scripts": {
      "install": "pnpm install --frozen-lockfile",
      "db": "docker compose up -d --wait db",
      "db:down": "docker compose down -v",
      // Explanations here are real comments, never `"// …"` keys: devbox turns every key
      // into a script and eats the leading slashes, so such a key becomes the command it
      // meant to document. See AGENTS.md § Development and issue #30.

      // db:generate builds first because a Plugin's drizzle.config.ts imports
      // defineKobaiDrizzleConfig from @kobai/core/migrations, and that specifier resolves
      // through the package's `exports` to dist — the same path a Plugin author outside
      // this repository takes. Recursive because every package that owns tables generates
      // its own migrations from its own schema, Core included.
      "db:generate": "pnpm -r build && pnpm -r db:generate",

      // There is deliberately no db:push script. This is the file kobai's commands live
      // in, so it is the file where someone would reach for the convenient one.
      // `drizzle-kit push` diffs against the LIVE database: run against a database
      // holding Plugin tables it reports success and silently drops them, leaving their
      // tracking rows so the migration runner believes the work is done and cannot repair
      // it. Generate a migration instead. Observed on branch
      // prototype/drizzle-multi-migration, FINDINGS.md section E; see
      // docs/adr/0030-generate-and-migrate-only-never-drizzle-kit-push.md.
      // tests/no-push-script.test.ts fails the build if a push script appears here.

      // openapi:generate needs neither a build nor a database: Node runs the TypeScript
      // directly, and the description is a property of the routes rather than of anything
      // behind them. Recursive, and the order is not incidental — pnpm walks the workspace
      // in dependency order, so @kobai/core writes openapi.json and @kobai/client then
      // regenerates itself from what Core wrote. Both files are checked in, and their
      // tests fail the gate when either has drifted.
      "openapi:generate": "pnpm -r openapi:generate",

      "up": "docker compose up --build",
      "down": "docker compose down",
      "build": "pnpm -r build",
      "dev": "pnpm -r build && pnpm --filter kobai-reference dev",
      "lint": "pnpm exec biome ci .",
      "format": "pnpm exec biome check --write .",
      "typecheck": "pnpm -r typecheck && pnpm exec tsc -p tsconfig.json --noEmit",
      "test": "docker compose up -d --wait db && pnpm -r build && pnpm exec vitest run",
      "ci": "pnpm install --frozen-lockfile && docker compose up -d --wait db && pnpm exec biome ci . && pnpm -r typecheck && pnpm exec tsc -p tsconfig.json --noEmit && pnpm -r build && pnpm exec vitest run"
    }
  }
}
