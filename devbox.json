{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": ["nodejs@22"],
  "env": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "shell": {
    "init_hook": [
      "corepack enable --install-directory \"$DEVBOX_PROJECT_ROOT/.devbox/virtenv/nodejs/corepack-bin\"",

      // One number, derived from the checkout's path, decides the port compose publishes,
      // the compose project the containers belong to, and the address the test harness
      // dials. They are set here, in front of every script, because the failure this
      // prevents is them disagreeing: the container comes up on one port while the suite
      // dials another, and neither error names the other. See AGENTS.md § Development.
      //
      // The path is what distinguishes two checkouts of kobai — a second clone, a git
      // worktree — and a path does not change between runs, so the container a run left
      // behind is still where the next run looks for it. A random port would not be.
      //
      // An explicit value still wins, and from `.env` as well as from the environment,
      // because `.env` is where a Developer is told to put these and docker compose reads
      // it too — a pin compose honoured while the harness ignored it would be the same
      // disagreement in a new place. Values are bare tokens here, quoted or not, so the
      // leading skip is everything up to the first alphanumeric and the capture stops at
      // the closing quote or comment.
      "kobai_dotenv() { sed -n \"s/^[[:space:]]*$1[[:space:]]*=[^[:alnum:]]*\\([[:alnum:]_.-]*\\).*/\\1/p\" \"$DEVBOX_PROJECT_ROOT/.env\" 2>/dev/null | tail -n 1; }",
      "kobai_pinned_port=${POSTGRES_PORT:-$(kobai_dotenv POSTGRES_PORT)}",
      "kobai_pinned_project=${COMPOSE_PROJECT_NAME:-$(kobai_dotenv COMPOSE_PROJECT_NAME)}",
      "kobai_hash=$(printf %s \"$DEVBOX_PROJECT_ROOT\" | cksum | cut -d' ' -f1)",

      // 55000-55999: the neighbourhood of the 55432 this repo has always used, and
      // nowhere near the 5432 a Developer's own Postgres sits on.
      "export POSTGRES_PORT=\"${kobai_pinned_port:-$((55000 + kobai_hash % 1000))}\"",

      // The project name carries the whole hash rather than the port, so two checkouts
      // that happened to derive the same port stay separate projects: they collide
      // loudly on the port instead of quietly sharing a volume. Without this the project
      // name is the checkout directory's basename, and two checkouts both called `kobai`
      // would share one database.
      "export COMPOSE_PROJECT_NAME=\"${kobai_pinned_project:-kobai-$(printf %08x \"$kobai_hash\")}\"",

      "export KOBAI_TEST_DATABASE_URL=\"${KOBAI_TEST_DATABASE_URL:-postgres://${POSTGRES_USER:-kobai}:${POSTGRES_PASSWORD:-kobai}@127.0.0.1:$POSTGRES_PORT/${POSTGRES_DB:-kobai}}\"",

      // `devbox run dev` runs the reference Project on the host against this same
      // container, so its DATABASE_URL is a third address that must not disagree either.
      // A URL is not a bare token, so this asks `.env` whether it has one rather than
      // trying to read it: `node --env-file` does not overwrite a variable already in the
      // environment, so exporting one unconditionally would silently beat a Developer's.
      "if ! grep -q \"^[[:space:]]*DATABASE_URL[[:space:]]*=\" \"$DEVBOX_PROJECT_ROOT/.env\" 2>/dev/null; then export DATABASE_URL=\"${DATABASE_URL:-postgres://${POSTGRES_USER:-kobai}:${POSTGRES_PASSWORD:-kobai}@127.0.0.1:$POSTGRES_PORT/${POSTGRES_DB:-kobai}}\"; fi",

      "unset kobai_pinned_port kobai_pinned_project kobai_hash",
      "unset -f kobai_dotenv"
    ],
    "scripts": {
      "install": "pnpm install --frozen-lockfile",
      "db": "docker compose up -d --wait db",
      "db:down": "docker compose down -v",
      // Explanations here are real comments, never `"// …"` keys: devbox turns every key
      // into a script and eats the leading slashes, so such a key becomes the command it
      // meant to document. See AGENTS.md § Development and issue #30.

      // db:generate builds first because a Plugin's drizzle.config.ts imports
      // defineKobaiDrizzleConfig from @kobai/core/migrations, and that specifier resolves
      // through the package's `exports` to dist — the same path a Plugin author outside
      // this repository takes. Recursive because every package that owns tables generates
      // its own migrations from its own schema, Core included.
      "db:generate": "pnpm -r build && pnpm -r db:generate",

      // There is deliberately no db:push script. This is the file kobai's commands live
      // in, so it is the file where someone would reach for the convenient one.
      // `drizzle-kit push` diffs against the LIVE database: run against a database
      // holding Plugin tables it reports success and silently drops them, leaving their
      // tracking rows so the migration runner believes the work is done and cannot repair
      // it. Generate a migration instead. Observed on branch
      // prototype/drizzle-multi-migration, FINDINGS.md section E; see
      // docs/adr/0030-generate-and-migrate-only-never-drizzle-kit-push.md.
      // tests/no-push-script.test.ts fails the build if a push script appears here.

      // openapi:generate needs neither a build nor a database: Node runs the TypeScript
      // directly, and the description is a property of the routes rather than of anything
      // behind them. Recursive, and the order is not incidental — pnpm walks the workspace
      // in dependency order, so @kobai/core writes openapi.json and @kobai/client then
      // regenerates itself from what Core wrote. Both files are checked in, and their
      // tests fail the gate when either has drifted.
      "openapi:generate": "pnpm -r openapi:generate",

      "up": "docker compose up --build",
      "down": "docker compose down",
      "build": "pnpm -r build",
      "dev": "pnpm -r build && pnpm --filter kobai-reference dev",

      // The Admin, with a reload loop, in a second terminal beside `devbox run dev`.
      //
      // It is a Vite dev server rather than the Project's process — nothing else gives a
      // Developer a reload — and it proxies `/admin`, `/store` and `/health` to the Project
      // on PORT. So the **browser still sees exactly one origin**, this one, which is what
      // production looks like too and why no CORS is configured anywhere (ADR-0010,
      // ADR-0033). A second origin would need CORS and would be a dev-only lie about the
      // deployment.
      //
      // `devbox run dev` already serves the *built* Admin at /admin-ui, because it builds
      // first. This is what to run when the Admin is the thing being edited.
      "admin:dev": "pnpm --filter kobai-reference-admin dev",
      "lint": "pnpm exec biome ci .",
      "format": "pnpm exec biome check --write .",
      "typecheck": "pnpm -r typecheck && pnpm exec tsc -p tsconfig.json --noEmit",
      "test": "docker compose up -d --wait db && pnpm -r build && pnpm exec vitest run",
      "ci": "pnpm install --frozen-lockfile && docker compose up -d --wait db && pnpm exec biome ci . && pnpm -r typecheck && pnpm exec tsc -p tsconfig.json --noEmit && pnpm -r build && pnpm exec vitest run"
    }
  }
}
