{
  "name": "kobai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "up": "node scripts/ensure-env.ts && docker compose build && node scripts/serving-on.ts && docker compose up",
    "down": "docker compose down",
    "db": "node scripts/ensure-env.ts && docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "dev": "node scripts/ensure-env.ts && pnpm -r build && node scripts/dev.ts",
    "admin:dev": "pnpm --filter kobai-reference-admin dev",
    "build": "pnpm -r build",
    "test": "node scripts/ensure-env.ts && docker compose up -d --wait db && pnpm run build && pnpm run browsers && vitest run",
    "browsers": "playwright install --only-shell chromium",
    "lint": "biome ci . --error-on-warnings",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm -r build && pnpm -r db:generate",
    "openapi:generate": "pnpm -r openapi:generate",
    "template:generate": "pnpm --filter create-kobai template:generate"
  },
  "pnpm": {
    "overrides": {
      "openapi-typescript>undici": "^7.29.0",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.18.0",
    "axe-core": "^4.13.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "verdaccio": "^6.9.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
