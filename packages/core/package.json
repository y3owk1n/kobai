{
  "name": "@kobai/core",
  "version": "0.1.0",
  "type": "module",
  "description": "The kobai packages a Project depends on.",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "bin": {
    "kobai-upgrade": "./dist/upgrade/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codemods": {
      "types": "./dist/upgrade/codemods.d.ts",
      "default": "./dist/upgrade/codemods.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "node scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
