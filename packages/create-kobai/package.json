{
  "name": "create-kobai",
  "version": "0.1.0",
  "type": "module",
  "description": "Generates a kobai Project you own outright, with kobai as an ordinary versioned dependency (ADR-0001).",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "bin": {
    "create-kobai": "./dist/bin/create-kobai.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./authoring": {
      "types": "./dist/src/authoring.d.ts",
      "default": "./dist/src/authoring.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "template:generate": "node scripts/sync-template.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
