# Every environment variable kobai reads. Copy to `.env` — which is gitignored — and edit.
# `docker compose up` works with the defaults below; nothing here is a secret worth keeping.
#
# This is the whole list. kobai deliberately has no environment variable for the session
# cookie: its `HttpOnly`, `SameSite=Strict` and `Path` are fixed, and `Secure` is derived
# per-request from `X-Forwarded-Proto` or the URL's protocol, so a deployment behind a
# terminating proxy needs nothing set and cannot set it wrongly (ADR-0032).

# --- The application (src/server.ts) -----------------------------------------------------

# Postgres connection string. Core applies its migrations against this at boot and refuses
# to start if they fail, so a container that is up is a container that migrated. `docker
# compose up` never reads this line — the app container talks to `db:5432` inside the compose
# network — but `devbox run dev`, which runs the app on your machine against the database in
# Docker, does. It is set rather than commented out because the application exits without it,
# and a commented line in the file you were told to copy is not a default, it is a trap.
DATABASE_URL=postgres://kobai:kobai@localhost:55432/kobai

# Port the application listens on — the API and the Admin, which is at /admin-ui on the same
# origin (ADR-0010, ADR-0033). `devbox run admin:dev` reads it too, because that is where its
# dev server proxies kobai's surfaces to; the browser still sees only the dev server's origin.
PORT=3000

# --- compose.yaml ------------------------------------------------------------------------

POSTGRES_USER=kobai
POSTGRES_PASSWORD=kobai
POSTGRES_DB=kobai
# Host port for the `db` service. Deliberately not 5432, so the Postgres you may already be
# running on this machine does not have to move.
POSTGRES_PORT=55432
