{
  "name": "kobai-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A kobai Project.",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "up": "docker compose up --build",
    "down": "docker compose down",
    "db": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "build": "pnpm --filter kobai-project-admin build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter kobai-project-admin typecheck && tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run build && node --env-file-if-exists=.env --watch src/server.ts",
    "admin:dev": "pnpm --filter kobai-project-admin dev",
    "start": "node dist/src/server.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@kobai/core": "^0.1.0",
    "@kobai/plugin-made-to-order": "^0.1.0",
    "@kobai/plugin-price-log": "^0.1.0",
    "@kobai/plugin-stripe": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "kobai-project-admin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}
