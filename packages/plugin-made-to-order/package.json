{
  "name": "@kobai/plugin-made-to-order",
  "version": "0.1.0",
  "type": "module",
  "description": "Made-to-order as a Plugin: one Fulfilment Strategy, one Step that surcharges for a Lead Time.",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@kobai/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
