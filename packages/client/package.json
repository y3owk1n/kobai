{
  "name": "@kobai/client",
  "version": "0.1.0",
  "type": "module",
  "description": "The typed TypeScript client, generated from kobai's OpenAPI description (ADR-0006).",
  "license": "MIT",
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "node generate.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@kobai/core": "workspace:*",
    "openapi-typescript": "6.7.6"
  }
}
