# Every environment variable kobai reads. Copy to `.env` — which is gitignored — and edit.
# `docker compose up` works with the defaults below; nothing here is a secret worth keeping.
#
# This is the whole list. kobai deliberately has no environment variable for the session
# cookie: its `HttpOnly`, `SameSite=Strict` and `Path` are fixed, and `Secure` is derived
# per-request from `X-Forwarded-Proto` or the URL's protocol, so a deployment behind a
# terminating proxy needs nothing set and cannot set it wrongly (ADR-0032).

# --- The application (src/server.ts) -----------------------------------------------------

# Postgres connection string. Core applies its migrations against this at boot and refuses
# to start if they fail, so a container that is up is a container that migrated. `docker
# compose up` never reads this line — the app container talks to `db:5432` inside the compose
# network — but `devbox run dev`, which runs the app on your machine against the database in
# Docker, does. It is set rather than commented out because the application exits without it,
# and a commented line in the file you were told to copy is not a default, it is a trap.
DATABASE_URL=postgres://kobai:kobai@localhost:55432/kobai

# Port the application listens on — the API and the Admin, which is at /admin-ui on the same
# origin (ADR-0010, ADR-0033). `devbox run admin:dev` reads it too, because that is where its
# dev server proxies kobai's surfaces to; the browser still sees only the dev server's origin.
PORT=3000

# Who this deployment's FIRST Merchant is — the account you sign in to the Admin with. Both
# are read at boot and the Merchant is created then, because kobai has no unauthenticated
# write path: on a deployment holding no Merchant there is nobody who could hold the
# permission `POST /admin/merchants` needs, so there is no way to create one over HTTP
# (ADR-0041). Every Merchant after this one is added from the Admin.
#
# Set both or neither; `compose.yaml` forwards them to the app container, so `docker compose
# up` reads them from here. With neither, the application still boots and serves — it says in
# its log that it has no Merchant, which is a deployment nobody can administer rather than a
# broken one. With one of the two, it says which half is missing. Booting again changes
# nothing: a deployment that already has a Merchant is left exactly as it is found, so these
# can be removed after the first boot and rotating them does not create a second account.
#
# The password is deliberately blank rather than filled in: a working default here would be a
# credential every deployment that did not read this line shared, and a documented password on
# a reachable Store is worse than no Merchant at all. Left blank, the first boot tells you
# which half is missing and creates nothing. Twelve characters minimum — length is the
# property that matters, so a passphrase beats a short tangle of symbols.
#
# It is stored as an argon2id digest and is never recoverable from anything kobai keeps — but
# it exists in this file and in whatever set it, so treat it as a secret. kobai never prints
# it. Changing it afterwards is not built yet.
KOBAI_INITIAL_MERCHANT_EMAIL=owner@example.test
KOBAI_INITIAL_MERCHANT_PASSWORD=

# --- compose.yaml ------------------------------------------------------------------------

POSTGRES_USER=kobai
POSTGRES_PASSWORD=kobai
POSTGRES_DB=kobai
# Host port for the `db` service. Deliberately not 5432, so the Postgres you may already be
# running on this machine does not have to move.
POSTGRES_PORT=55432
