{
  "name": "kobai-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The reference Project — kobai's own Project, and its release gate (ADR-0029).",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "up": "docker compose up --build",
    "down": "docker compose down",
    "db": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "build": "pnpm --filter kobai-reference-admin build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter kobai-reference-admin typecheck && tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run build && node --env-file-if-exists=.env --watch src/server.ts",
    "admin:dev": "pnpm --filter kobai-reference-admin dev",
    "start": "node dist/src/server.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@kobai/core": "workspace:*",
    "@kobai/plugin-made-to-order": "workspace:*",
    "@kobai/plugin-price-log": "workspace:*",
    "@kobai/plugin-stripe": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "kobai-reference-admin": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
