{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Admin runs in a browser, so the base config's Node-shaped module settings are
    // replaced rather than extended: Vite is the resolver, and `preserve` leaves the import
    // syntax for it to read. `dom` joins the lib list for the same reason.
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // `vite.config.ts` is Node's, and is included here so it is checked at all; `vite/client`
    // arrives through `src/vite-env.d.ts`, which is where Vite's own template puts it.
    "types": ["node"],
    // `paths` replaces the base config's map rather than extending it, so every mapping the
    // Admin uses is repeated here. `@/*` is the Admin's own alias and matches
    // `vite.config.ts`'s `resolve.alias`; the two are read by different tools and have to
    // agree. Anything not mapped here — `@kobai/client` among them — resolves through
    // `node_modules`, which is what `vite build` does anyway.
    "paths": {
      "@/*": ["./src/*"],
      "@kobai/client": ["../../packages/client/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
