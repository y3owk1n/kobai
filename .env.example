# Every environment variable kobai reads. Copy to `.env` — which is gitignored — and edit.
# `docker compose up` works with the defaults below; nothing here is a secret worth keeping.

# --- The reference Project (reference/src/server.ts) -------------------------------------

# Postgres connection string. Core applies its migrations against this at boot and refuses
# to start if they fail.
DATABASE_URL=postgres://kobai:kobai@localhost:55432/kobai

# Port the application listens on.
PORT=3000

# --- compose.yaml ------------------------------------------------------------------------

POSTGRES_USER=kobai
POSTGRES_PASSWORD=kobai
POSTGRES_DB=kobai
# Host port for the `db` service. Deliberately not 5432.
POSTGRES_PORT=55432

# --- Tests ------------------------------------------------------------------------------

# The Postgres the test harness connects to. It creates and drops a throwaway database per
# test file, so this points at the maintenance database rather than at a test database.
# Defaults to the compose `db` service above when unset.
KOBAI_TEST_DATABASE_URL=postgres://kobai:kobai@localhost:55432/kobai
